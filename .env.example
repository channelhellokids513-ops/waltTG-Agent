# ==============================================================================
# WALT TRADING BOT - ENVIRONMENT CONFIGURATION
# ==============================================================================
# Panduan:
# 1. Salin isi file ini ke file bernama `.env` di folder utama.
# 2. Isi nilai kredensial di bawah ini.
# 3. File `.env` sudah masuk dalam `.gitignore` sehingga aman dari commit Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. WALT PERPS OAUTH CREDENTIALS (WAJIB)
# ------------------------------------------------------------------------------
# Client ID aplikasi dari pendaftaran DCR
WALT_CLIENT_ID=a8411c43-08b9-461e-bff0-512919f1825f

# Refresh token yang diperoleh setelah menjalankan: python setup_walt_oauth.py
WALT_REFRESH_TOKEN=isi_dengan_walt_refresh_token_anda

# ------------------------------------------------------------------------------
# 2. ALIBABA CLOUD / QWEN AI RESEARCH (OPSIONAL - BISA ISI 'dummy')
# ------------------------------------------------------------------------------
# API Key untuk analisis riset sentimen pasar menggunakan LLM Qwen
# Dapatkan di: https://modelstudio.console.alibabacloud.com/ap-southeast-1/model/settings/api-key
DASHSCOPE_API_KEY=dummy

# Model Qwen yang digunakan (Pilihan: qwen-turbo, qwen-plus, qwen-max)
DASHSCOPE_MODEL=qwen-plus

# ------------------------------------------------------------------------------
# 3. TELEGRAM NOTIFICATION ALERTS (OPSIONAL - BISA ISI 'dummy')
# ------------------------------------------------------------------------------
# Token bot Telegram dari @BotFather
TELEGRAM_BOT_TOKEN=dummy

# Chat ID penerima pesan notifikasi dari @userinfobot
TELEGRAM_CHAT_ID=dummy

# ------------------------------------------------------------------------------
# 4. BOT EXECUTION SETTINGS
# ------------------------------------------------------------------------------
# Set "true" untuk simulasi (preview mode tanpa eksekusi order riil)
DRY_RUN=false
