# ==============================================================================
# WALT TRADING BOT - ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================
# Panduan:
# 1. Salin isi file ini ke file bernama `.env` di folder utama.
# 2. Isi nilai kredensial asli Anda pada `.env` (file `.env` di-ignore oleh Git).
# 3. Seluruh nilai di bawah ini HANYA placeholder — jangan pernah commit rahasia.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. WALT PERPS OAUTH CREDENTIALS (WAJIB)
# ------------------------------------------------------------------------------
# Client ID aplikasi OAuth Walt dari pendaftaran DCR
WALT_CLIENT_ID=your-walt-client-id

# Refresh token OAuth Walt dari setup_walt_oauth.py (di-rotate otomatis)
WALT_REFRESH_TOKEN=your-walt-refresh-token

# ------------------------------------------------------------------------------
# 2. AI RESEARCH SWARM — QWEN & GEMINI (OPSIONAL - BISA ISI 'dummy')
# ------------------------------------------------------------------------------
# API Key Alibaba Cloud DashScope untuk model Qwen
DASHSCOPE_API_KEY=dummy

# Nama model Qwen yang digunakan (contoh: qwen-plus, qwen-turbo, qwen-max)
DASHSCOPE_MODEL=qwen-plus

# API Key Google Gemini (nama utama yang dibaca llm_research.py & workflows)
DASHSCOPE_API_GEMINI_KEY=dummy

# Alias fallback API Key Google Gemini jika DASHSCOPE_API_GEMINI_KEY kosong
GEMINI_API_KEY=dummy

# Nama model Gemini untuk swarm research (default: gemini-flash-latest)
GEMINI_MODEL=gemini-flash-latest

# ------------------------------------------------------------------------------
# 3. TELEGRAM NOTIFICATION ALERTS (OPSIONAL - BISA ISI 'dummy')
# ------------------------------------------------------------------------------
# Token bot Telegram dari @BotFather
TELEGRAM_BOT_TOKEN=dummy

# Chat ID penerima notifikasi dari @userinfobot
TELEGRAM_CHAT_ID=dummy

# ------------------------------------------------------------------------------
# 4. GOOGLE SHEETS LOGGING & WEBHOOK
# ------------------------------------------------------------------------------
# ID Google Spreadsheet untuk ekspor CSV & pencatatan audit
GOOGLE_SHEET_ID=your-sheet-id

# URL Google Apps Script Web App (/exec) untuk webhook log_scan/log_execution/log_close/log_pnl
GOOGLE_SHEET_WEBHOOK_URL=https://script.google.com/macros/s/your-deployment-id/exec

# ------------------------------------------------------------------------------
# 5. GITHUB ACTIONS AUTO-SYNC & SHARED STRATEGY CONFIG
# ------------------------------------------------------------------------------
# GitHub Personal Access Token (scope repo/secrets) untuk auto-sync WALT_REFRESH_TOKEN & vars
# Urutan fallback workflow CI: GH_PAT -> GH_PATH -> GITHUB_PAT -> PAT (saat ini hanya GH_PATH yang terpasang di repo)
# Lihat README bagian "Jendela Pemeliharaan & Pemulihan Kredensial" sebelum rotasi/diagnostik lokal
GH_PAT=dummy
GH_PATH=
GITHUB_PAT=

# Nama repository GitHub format "owner/repo" (otomatis diset di GitHub Actions)
GITHUB_REPOSITORY=owner/walt-trading

# Override JSON parameter strategi bersama (biasanya dikelola via GitHub Actions Variable)
STRATEGY_CONFIG_JSON=

# ------------------------------------------------------------------------------
# 6. BOT EXECUTION, CADENCE & SAFETY CONTROLS
# ------------------------------------------------------------------------------
# Set "true" untuk simulasi (preview saja tanpa eksekusi order riil)
DRY_RUN=false

# Set "true" agar daily scan langsung mengeksekusi sinyal GO/HALF yang lolos filter
AUTO_EXECUTE_ON_SCAN=true

# Set "true" agar risk-monitor dapat memicu market/crypto execute adaptif saat ada momentum/TP
ADAPTIVE_EXECUTION_ENABLED=true

# Set "true" agar risk-monitor menjalankan sub-siklus 5 menit untuk posisi berisiko (HALF)
DYNAMIC_MONITOR_SUBCYCLE=true

# Batas waktu eksekusi job (menit) yang dipakai oleh guard has_enough_job_time()
JOB_TIMEOUT_MIN=12

# Set "true" di repo publik / CI agar angka saldo, margin, PnL, dan order_id disamarkan di stdout
LOG_REDACT=true

# ------------------------------------------------------------------------------
# 7. GOOGLE OAUTH & RBAC TELEGRAM BOT (KEAMANAN & MULTI-USER)
# ------------------------------------------------------------------------------
# OAuth 2.0 Client ID (tipe TV and Limited Input / Desktop) dari Google Cloud Console
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id

# OAuth 2.0 Client Secret dari Google Cloud Console
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret

# Email Google Administrator utama untuk manajemen bot Telegram
ADMIN_GOOGLE_EMAIL=admin@example.com

# Daftar email Google tambahan yang diizinkan (pisahkan dengan koma)
ALLOWED_GOOGLE_EMAILS=user1@example.com,user2@example.com

# Set "true" untuk mewajibkan login Google OAuth pada setiap sesi Telegram bot
REQUIRE_GOOGLE_AUTH=false

# Masa berlaku sesi autentikasi Google OAuth (dalam jam)
AUTH_SESSION_TTL_HOURS=24
